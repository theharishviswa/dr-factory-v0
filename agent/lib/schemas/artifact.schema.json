{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory Artifact",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "path",
    "source",
    "created_at",
    "created_by_agent",
    "version",
    "dependencies",
    "summary",
    "acceptance_status"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "source_email",
        "source_attachment",
        "requirements",
        "dataset_raw",
        "dataset_profile",
        "business_rules",
        "human_review_queue",
        "deliverable",
        "review_report",
        "factory_memory"
      ]
    },
    "path": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_by_agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "acceptance_status": {
      "type": "string",
      "enum": [
        "pending_source",
        "draft",
        "ready_for_review",
        "accepted",
        "rejected"
      ]
    }
  }
}

