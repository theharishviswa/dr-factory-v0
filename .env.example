# Required only for live autonomous LLM calls.
OPENAI_API_KEY=

# Optional. Defaults to the model in config/model_providers.json.
DR_FACTORY_MODEL=gpt-5

# dry-run avoids external model calls. live calls the configured provider.
DR_FACTORY_MODE=dry-run

# Keep output bounded and avoid storing full provider payloads by default.
DR_FACTORY_MAX_OUTPUT_TOKENS=6000
DR_FACTORY_CAPTURE_RAW_MODEL_RESPONSE=false

# Optional path to the Python runtime containing requirements.txt dependencies.
DR_FACTORY_PYTHON=python3
